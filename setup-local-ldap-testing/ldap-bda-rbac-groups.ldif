# =============================================================================
# Big-Data Analytics (BDA) RBAC Groups — demo seed for the custom GroupSync CR
# =============================================================================
# Naming standard: bda-rbac-{service}-{environment}-{kind}
#   service:     spark | trino
#   environment: alpha | delta | theta
#   kind:        apps  | users
# The custom CR "bda-rbac-groupsync" syncs all of these via cn=bda-rbac-*.
#
# Import (test LDAP already running):
#   kubectl cp ldap-bda-rbac-groups.ldif ldap-testing/<ldap-pod>:/tmp/
#   kubectl exec -n ldap-testing <ldap-pod> -- ldapadd -x -H ldap://localhost:389 \
#       -D "cn=admin,dc=ephico2real,dc=com" -w admin123 -f /tmp/ldap-bda-rbac-groups.ldif
#
# Members reuse the existing test users from ldap-structure-combined.ldif.
# groupOfNames requires at least one member, so every group has one.
# =============================================================================

# ---- Spark · alpha ----
dn: cn=bda-rbac-spark-alpha-apps,ou=Groups,dc=ephico2real,dc=com
objectClass: groupOfNames
cn: bda-rbac-spark-alpha-apps
description: BDA Spark alpha application service accounts
member: cn=john.doe,ou=People,dc=ephico2real,dc=com

dn: cn=bda-rbac-spark-alpha-users,ou=Groups,dc=ephico2real,dc=com
objectClass: groupOfNames
cn: bda-rbac-spark-alpha-users
description: BDA Spark alpha human users
member: cn=jane.smith,ou=People,dc=ephico2real,dc=com
member: cn=bob.wilson,ou=People,dc=ephico2real,dc=com

