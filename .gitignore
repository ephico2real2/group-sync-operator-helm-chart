# Helm
# Helm subchart tarballs, which live INSIDE a chart at <chart>/charts/. NOT a bare `charts/`:
# the chart itself now lives at charts/group-sync-operator-helm, and a bare pattern makes every new
# file under it invisible to git — `git status` shows nothing and it is silently left out of the chart.
# The existing files survived only because `git mv` staged them while they were already tracked.
charts/*/charts/
Chart.lock

# NOT *.tgz. chart-releaser packages the chart and, with packages_with_index, git-adds the .tgz onto
# the gh-pages branch — which a *.tgz rule blocks, failing the release with
# "The following paths are ignored by one of your .gitignore files: <chart>-<version>.tgz".
# These are chart-releaser's own working directories, which is what actually wants ignoring.
.cr-release-packages/
.cr-index/

# OS
.DS_Store

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Temp directories
temp/
tmp/

# Cluster state captured before a destructive reinstall. These hold real Group objects,
# their LDAP source DNs and the bind credentials secret — never commit them to a chart
# repo that gets published.
.backup-*/

# Local backups taken by 15-bootstrap-cert-manager-ca.sh before replacing a CA ConfigMap.
setup-local-ldap-testing/.ca-configmap-backup/
# Also matched at any depth, since BACKUP_DIR can be overridden.
.ca-configmap-backup/

# Copies of oauth/cluster taken by 40-setup-oauth-ldap-login.sh before it adds an identity provider.
# They contain the cluster's full identity provider configuration — every bindDN, every secret and CA
# reference — which is exactly the shape of a real directory's integration and does not belong in a
# published chart repo.
setup-local-ldap-testing/.oauth-backup/
.oauth-backup/

# Python bytecode. A .pyc for ci/url-guard.py was committed by accident — `python3 ci/url-guard.py`
# writes it, and a `git add -A` afterwards picks it up. It is build output for one interpreter version
# (cpython-313 here), so it is both noise and wrong for anyone on another version.
__pycache__/
*.pyc
