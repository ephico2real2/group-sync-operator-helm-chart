# Patterns to ignore when building Helm packages.
# Standard VCS / editor / OS cruft
.git/
.gitignore
.github/
.github-no-deploy/
*.tmproj
*.swp
*.bak
*.orig
.DS_Store
.idea/
.vscode/

# Repo assets that are NOT part of the deployable chart
templates-backup/            # pre-edit snapshot of templates/ (local safety only)
docs/                        # design docs
setup-local-ldap-testing/    # local test-LDAP harness
scripts/                     # helper scripts
docker/                      # image build context
argocd-application.yaml      # ArgoCD wrapper, applied separately
CONTRIBUTING.md
rendered-templates.yaml
